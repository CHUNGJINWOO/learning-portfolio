<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>launch_orchestration_py</name>
  <version>1.0.0</version>
  <description>ROS 2 Humble Launch and multi-node system orchestration learning module.</description>
  <maintainer email="portfolio@example.com">ROS 2 Learning Portfolio</maintainer>
  <license>Apache-2.0</license>

  <depend>launch</depend>
  <depend>launch_ros</depend>

  <exec_depend>core_pubsub_py</exec_depend>
  <exec_depend>param_qos_py</exec_depend>
  <exec_depend>service_action_py</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
