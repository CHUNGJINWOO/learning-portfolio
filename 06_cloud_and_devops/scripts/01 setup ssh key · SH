#!/bin/bash
# =====================================================================
# 01_setup_ssh_key.sh
# 실행 위치: 노트북의 WSL2 (Ubuntu)
# 목적: 오라클 클라우드 서버에 비밀번호 없이 접속하기 위한 SSH 키를 생성한다.
#       암호 없는 키는 이후 rsync/rclone 자동화 스크립트가
#       사람의 개입 없이 무인으로 실행되기 위한 전제조건이다.
# =====================================================================
 
set -e  # 명령 중 하나라도 실패하면 즉시 스크립트를 중단 (자동화 스크립트의 안전장치)
 
ORACLE_HOST="100.127.79.18"   # Tailscale 사설 IP (ros2-server)
KEY_PATH="$HOME/.ssh/oracle_key"
 
# 1) ed25519 키 쌍 생성
#    -t ed25519 : RSA보다 짧고 빠르면서 보안성이 높은 최신 키 타입
#    -N ""      : 암호(passphrase) 없이 생성 — 무인 자동화를 위해 필수
#    -f         : 저장할 경로 지정
ssh-keygen -t ed25519 -f "$KEY_PATH" -N ""
 
echo ""
echo "공개키 생성 완료. 아래 내용을 오라클 서버의 authorized_keys에 등록해야 합니다:"
echo "----------------------------------------------------------------------"
cat "${KEY_PATH}.pub"
echo "----------------------------------------------------------------------"
echo ""
echo "※ 오라클 클라우드 우분투 이미지는 기본적으로 비밀번호 SSH 로그인이 꺼져 있어"
echo "   ssh-copy-id가 실패할 수 있습니다. 이 경우, 인스턴스 생성 시 받은"
echo "   '원래 개인키'로 먼저 접속한 뒤 서버 안에서 아래 명령으로 수동 등록하세요:"
echo ""
echo "   ssh -i <원래_개인키_경로> ubuntu@${ORACLE_HOST}"
echo '   echo "<위에 출력된 공개키 한 줄>" >> ~/.ssh/authorized_keys'
echo ""
echo "등록 후 접속 테스트:"
echo "   ssh -i ${KEY_PATH} ubuntu@${ORACLE_HOST}"
 