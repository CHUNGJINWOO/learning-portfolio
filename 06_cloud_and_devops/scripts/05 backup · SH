#!/bin/bash
# =====================================================================
# 05_backup.sh
# 실행 위치: 노트북의 WSL2 (Ubuntu) — Windows 작업 스케줄러가 이 스크립트를 호출한다.
# 목적: 시뮬레이션 결과물을 두 곳에 자동으로 백업한다.
#   1) 오라클 블록 볼륨(150GB, /mnt/data) — 전체 결과물, 대용량 주력 저장소
#   2) 오라클 오브젝트 스토리지(20GB, rclone) — 그중 "중요한 것만" 이중 백업
#
# 사전 조건: 01_setup_ssh_key.sh, 02_mount_data_volume.sh, 04_setup_rclone.sh
#            가 모두 완료되어 있어야 한다 (키 인증 + 마운트 + rclone remote 등록).
# =====================================================================
 
set -e
 
# ---- 설정 값 ----
SSH_KEY="$HOME/.ssh/oracle_key"
ORACLE_HOST="100.127.79.18"                 # Tailscale 사설 IP
REMOTE_DATA_PATH="/mnt/data/limo-results/"   # 블록 볼륨 쪽 백업 경로
 
LOCAL_RESULTS_DIR="$HOME/limo_ws/results/"           # 전체 결과물
LOCAL_IMPORTANT_DIR="$HOME/limo_ws/results/important/"  # 발표자료, 최종 맵 등 핵심 파일만
 
RCLONE_REMOTE="oracle-obj:limo-backup/"      # rclone 원격 저장소 경로
 
LOG_FILE="$HOME/limo_ws/backup.log"
 
# ---- 백업 실행 ----
echo "===== 백업 시작: $(date) =====" >> "$LOG_FILE"
 
# 1) 블록 볼륨으로 전체 결과물 동기화
#    -a : 권한/시간 등 속성 보존한 채 복사 (아카이브 모드)
#    -v : 진행 상황 출력
#    -z : 전송 중 압축 (네트워크 대역폭 절약)
#    --update : 이미 옮겨진 파일 중 변경 없는 것은 건너뛰어, 매번 전체를 재전송하지 않음
rsync -avz --update \
    -e "ssh -i ${SSH_KEY}" \
    "$LOCAL_RESULTS_DIR" \
    "ubuntu@${ORACLE_HOST}:${REMOTE_DATA_PATH}" \
    >> "$LOG_FILE" 2>&1
 
echo "  → 블록 볼륨 동기화 완료" >> "$LOG_FILE"
 
# 2) 오브젝트 스토리지로 핵심 파일만 이중 백업
#    (important 폴더가 없으면 이 단계는 건너뜀)
if [ -d "$LOCAL_IMPORTANT_DIR" ]; then
    rclone sync "$LOCAL_IMPORTANT_DIR" "$RCLONE_REMOTE" >> "$LOG_FILE" 2>&1
    echo "  → 오브젝트 스토리지 이중 백업 완료" >> "$LOG_FILE"
else
    echo "  → ${LOCAL_IMPORTANT_DIR} 없음, 오브젝트 스토리지 백업 건너뜀" >> "$LOG_FILE"
fi
 
echo "===== 백업 종료: $(date) =====" >> "$LOG_FILE"
echo "" >> "$LOG_FILE"
 